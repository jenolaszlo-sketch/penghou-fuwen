<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <FuwenPackageVersion Condition="'$(FuwenPackageVersion)' == ''">0.1.0-preview.10-local</FuwenPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="1.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0-pre.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Penghou.Zhinu.Sqlite" Version="0.1.0-preview.14" />
    <PackageReference Include="Penghou.Fuwen" Version="$(FuwenPackageVersion)" />
    <PackageReference Include="Penghou.Fuwen.Compiler" Version="$(FuwenPackageVersion)" />
    <PackageReference Include="Penghou.Fuwen.Zhinu" Version="$(FuwenPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
