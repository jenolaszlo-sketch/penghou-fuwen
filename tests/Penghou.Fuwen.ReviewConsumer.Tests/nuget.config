<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="consumer-feed" value="../../artifacts" />
    <add key="zhinu-candidate" value="../../artifacts/zhinu-candidate" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="consumer-feed"><package pattern="Penghou.Fuwen*" /></packageSource>
    <packageSource key="zhinu-candidate"><package pattern="Penghou.Zhinu*" /></packageSource>
    <packageSource key="nuget"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
