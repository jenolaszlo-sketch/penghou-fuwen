toolset research_tools {
  use "sample.search@1#ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff";
}

prompt concise_greeting(name: string) {
  system "Answer briefly."
  user "Greet {{ name }}."
}

prompt registered_greeting(name: string) uses registered "sample.prompt@1#eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee";

workflow documented_inference(input: string) -> string {
  context facts = context "sample.context@1#cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" (request: input;) -> string;
  infer owned = infer "sample.profile@1#dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" prompt concise_greeting(name: input;) tools research_tools with facts limits maxTokens 256 timeout 30 -> string;
  infer aliased = infer "sample.profile@1#dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" prompt registered_greeting(name: input;) tools ["sample.search@1#ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"] -> string;
  infer direct = infer "sample.profile@1#dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" using "sample.prompt@1#eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" (request: input;) tools none -> string;
  return direct;
}
